APP_NAME="Brillance Plus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
# Use an address on your own domain once mail is configured.
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Brillance Plus — public contact details (see config/business.php)
BUSINESS_PHONE="+330780647327"
BUSINESS_PHONE_DISPLAY="07 80 64 73 27"
# Public email shown on the website (mailto links are hidden while empty).
BUSINESS_EMAIL=
# WhatsApp number in international format (leave empty to hide WhatsApp).
BUSINESS_WHATSAPP="+33 7 80 64 73 27"
# Messenger: a Facebook page/profile address, an m.me link or a username (hidden while empty).
BUSINESS_MESSENGER=
# Recipient of quote-request notifications (defaults to BUSINESS_EMAIL).
INQUIRY_NOTIFICATION_EMAIL=
# Send a confirmation email to customers. Enable only once mail delivery works.
INQUIRY_SEND_CUSTOMER_CONFIRMATION=false

# Legal notice details (shown as "to be completed" while empty).
LEGAL_COMPANY_NAME=
LEGAL_FORM=
LEGAL_ADDRESS=
LEGAL_REGISTRATION_NUMBER=
LEGAL_VAT_NUMBER=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_HOST=
LEGAL_CONSUMER_MEDIATOR=
